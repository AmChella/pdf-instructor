{
  "manifest_version": 3,
  "name": "PDF Instructor",
  "version": "1.0.0",
  "description": "Interactive PDF viewer with image and table detection, highlighting, and coordinate submission functionality",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDF Instructor",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.css", "viewer.js", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}